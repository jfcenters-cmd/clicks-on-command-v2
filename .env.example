# Public URL of this deployment (use your Vercel URL until clicksoncommand.com DNS points here)
# NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/clicksoncommand/30min
NEXT_PUBLIC_META_PIXEL_ID=

# Optional: POST JSON leads { firstName, email, phone, source, submittedAt } — e.g. Zapier/Make webhook
# OPTIN_WEBHOOK_URL=

# Optional: Close CRM — Settings → Developer → API keys (server only; add in Vercel, never commit)
# CLOSE_API_KEY=

# Optional: Beehiiv — Developers → API (publication id looks like pub_xxxx)
# BEEHIIV_API_KEY=
# BEEHIIV_PUBLICATION_ID=
# Optional: if your publication has a custom field for first name, set exact field name as in Beehiiv UI
# BEEHIIV_FIRST_NAME_FIELD_NAME=First Name
